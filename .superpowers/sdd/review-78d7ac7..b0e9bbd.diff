index 0000000..07baaaf
--- /dev/null
+++ b/computer-vision/detector/pipeline.py
@@ -0,0 +1,303 @@
+"""Webcam capture and walking-cue inference loop."""
+
+from __future__ import annotations
+
+import sys
+import threading
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+_DETECTOR_DIR = Path(__file__).resolve().parent
+if str(_DETECTOR_DIR) not in sys.path:
+    sys.path.insert(0, str(_DETECTOR_DIR))
+
+from failure_reason import quiet_failure_reason
+from policy import Box, Cue, PolicyState, decide
+from quality import frame_is_usable
+from webcam import open_webcam
+from yolo import letterbox, predictions_to_boxes
+
+WEIGHT_PATH = _DETECTOR_DIR / "weights" / "yolo11n.onnx"
+INFER_PERIOD = 0.125
+MODES = ("general", "crosswalk", "depth")
+QUIET = Cue(kind="quiet", speech="", reason="camera-missing", side=None, class_name=None)
+
+
+def _quiet(reason: str) -> Cue:
+    return Cue(kind="quiet", speech="", reason=reason, side=None, class_name=None)
+
+
+class Pipeline:
+    """Newest-frame capture plus an 8 Hz detector. Never raises on missing camera or weights."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._frame: np.ndarray | None = None
+        self._jpeg: bytes | None = None
+        self._cue = QUIET
+        self._inference_ms = 0
+        self._mode = "general"
+        self._source = "webcam"
+        self._index = 0
+        self._camera_opened = False
+        self._capture: cv2.VideoCapture | None = None
+        self._capture_thread: threading.Thread | None = None
+        self._capture_stop = threading.Event()
+        self._capture_gen = 0
+        self._infer_thread: threading.Thread | None = None
+        self._infer_stop = threading.Event()
+        self._policy_state = PolicyState()
+        self._session = None
+        self._input_name: str | None = None
+        self._started = False
+
+    def start(self) -> None:
+        """Start webcam index 0 and the inference loop. Safe with no camera and no weights."""
+        try:
+            if self._infer_thread is None or not self._infer_thread.is_alive():
+                self._infer_stop.clear()
+                self._infer_thread = threading.Thread(
+                    target=self._inference_loop, name="detector-infer", daemon=True
+                )
+                self._infer_thread.start()
+            self.set_source_webcam(0)
+            self._started = True
+        except Exception:
+            self._started = True
+
+    def set_mode(self, mode: str) -> None:
+        if mode not in MODES:
+            return
+        with self._lock:
+            self._mode = mode
+
+    def set_source_webcam(self, index: int) -> None:
+        self._index = int(index)
+        with self._lock:
+            self._source = "webcam"
+        self._restart_capture()
+
+    def set_source_esp32(self) -> None:
+        self._stop_capture()
+        with self._lock:
+            self._source = "esp32"
+            self._frame = None
+            self._jpeg = None
+            self._camera_opened = False
+            self._cue = _quiet("esp32")
+            self._inference_ms = 0
+
+    def snapshot(self) -> dict:
+        with self._lock:
+            cue = self._cue
+            return {
+                "kind": cue.kind,
+                "speech": cue.speech,
+                "reason": cue.reason,
+                "side": cue.side,
+                "class_name": cue.class_name,
+                "inference_ms": self._inference_ms,
+                "mode": self._mode,
+                "jpeg": self._jpeg,
+                "source": self._source,
+            }
+
+    def _restart_capture(self) -> None:
+        self._stop_capture()
+        self._capture_stop.clear()
+        with self._lock:
+            self._frame = None
+            self._camera_opened = False
+            self._capture_gen += 1
+            gen = self._capture_gen
+        self._capture_thread = threading.Thread(
+            target=self._capture_loop, args=(gen,), name="detector-capture", daemon=True
+        )
+        self._capture_thread.start()
+
+    def _stop_capture(self) -> None:
+        self._capture_stop.set()
+        thread = self._capture_thread
+        if thread is not None and thread.is_alive() and thread is not threading.current_thread():
+            thread.join(timeout=2.0)
+        capture = None
+        with self._lock:
+            capture = self._capture
+            self._capture = None
+            self._capture_thread = None
+            self._frame = None
+            self._camera_opened = False
+        if capture is not None:
+            try:
+                capture.release()
+            except Exception:
+                pass
+
+    def _capture_loop(self, gen: int) -> None:
+        try:
+            capture = open_webcam(self._index)
+        except Exception:
+            capture = None
+        opened = bool(capture is not None and capture.isOpened())
+        with self._lock:
+            if gen != self._capture_gen:
+                stale = True
+            else:
+                stale = False
+                self._capture = capture
+                self._camera_opened = opened
+                if not opened:
+                    self._frame = None
+        if stale:
+            if capture is not None:
+                try:
+                    capture.release()
+                except Exception:
+                    pass
+            return
+        if not opened:
+            while not self._capture_stop.is_set():
+                self._capture_stop.wait(0.1)
+            if capture is not None:
+                try:
+                    capture.release()
+                except Exception:
+                    pass
+            return
+        while not self._capture_stop.is_set():
+            ok, frame = capture.read()
+            if ok and frame is not None:
+                with self._lock:
+                    self._frame = frame
+            else:
+                self._capture_stop.wait(0.01)
+
+    def _inference_loop(self) -> None:
+        while not self._infer_stop.is_set():
+            started = time.monotonic()
+            try:
+                self._infer_once()
+            except Exception:
+                with self._lock:
+                    frame = self._frame
+                    opened = self._camera_opened
+                    source = self._source
+                reason = quiet_failure_reason(
+                    source=source,
+                    has_frame=frame is not None,
+                    camera_opened=opened,
+                )
+                with self._lock:
+                    self._cue = _quiet(reason)
+                    self._inference_ms = 0
+            remaining = INFER_PERIOD - (time.monotonic() - started)
+            if remaining > 0:
+                self._infer_stop.wait(remaining)
+
+    def _infer_once(self) -> None:
+        with self._lock:
+            frame = None if self._frame is None else self._frame.copy()
+            opened = self._camera_opened
+            source = self._source
+        if source == "esp32":
+            self._publish(_quiet("esp32"), 0, None, [])
+            return
+        if frame is None or not opened:
+            self._publish(_quiet("camera-missing"), 0, frame, [])
+            return
+
+        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+        if not frame_is_usable(gray):
+            self._publish(_quiet("unsteady"), 0, frame, [])
+            return
+
+        if not WEIGHT_PATH.is_file():
+            self._publish(_quiet("model-missing"), 0, frame, [])
+            return
+
+        session = self._load_session()
+        if session is None or self._input_name is None:
+            self._publish(_quiet("model-missing"), 0, frame, [])
+            return
+
+        infer_started = time.monotonic()
+        boxed = letterbox(frame)
+        rgb = cv2.cvtColor(boxed.image, cv2.COLOR_BGR2RGB)
+        tensor = rgb.astype(np.float32) / 255.0
+        nchw = np.transpose(tensor, (2, 0, 1))[None, ...]
+        outputs = session.run(None, {self._input_name: nchw})
+        boxes = predictions_to_boxes(outputs[0], boxed)
+        inference_ms = int(round((time.monotonic() - infer_started) * 1000))
+        cue, self._policy_state = decide(
+            boxes,
+            int(frame.shape[1]),
+            int(frame.shape[0]),
+            time.monotonic(),
+            self._policy_state,
+        )
+        self._publish(cue, inference_ms, frame, boxes)
+
+    def _load_session(self):
+        if self._session is not None:
+            return self._session
+        try:
+            import onnxruntime as ort
+
+            session = ort.InferenceSession(
+                str(WEIGHT_PATH), providers=["CPUExecutionProvider"]
+            )
+            self._session = session
+            self._input_name = session.get_inputs()[0].name
+            return session
+        except Exception:
+            self._session = None
+            self._input_name = None
+            return None
+
+    def _publish(
+        self,
+        cue: Cue,
+        inference_ms: int,
+        frame: np.ndarray | None,
+        boxes: list[Box],
+    ) -> None:
+        jpeg = None
+        if frame is not None:
+            annotated = _draw_boxes(frame, boxes)
+            ok, encoded = cv2.imencode(".jpg", annotated)
+            if ok:
+                jpeg = encoded.tobytes()
+        with self._lock:
+            self._cue = cue
+            self._inference_ms = inference_ms
+            if jpeg is not None:
+                self._jpeg = jpeg
+
+
+def _draw_boxes(frame: np.ndarray, boxes: list[Box]) -> np.ndarray:
+    out = frame.copy()
+    for box in boxes:
+        x0 = int(round(box.x0))
+        y0 = int(round(box.y0))
+        x1 = int(round(box.x1))
+        y1 = int(round(box.y1))
+        cv2.rectangle(out, (x0, y0), (x1, y1), (215, 235, 180), 2)
+        label = box.class_name
+        baseline = max(y0 - 8, 16)
+        cv2.putText(
+            out,
+            label,
+            (x0, baseline),
+            cv2.FONT_HERSHEY_SIMPLEX,
+            0.6,
+            (215, 235, 180),
+            2,
+            cv2.LINE_AA,
+        )
+    return out
+
+
+PIPELINE = Pipeline()
diff --git a/computer-vision/detector/policy.py b/computer-vision/detector/policy.py
new file mode 100644
index 0000000..3073848
--- /dev/null
+++ b/computer-vision/detector/policy.py
@@ -0,0 +1,192 @@
+from dataclasses import dataclass
+
+HOLD_SECONDS = 4.0
+LEFT_FRACTION = 0.35
+RIGHT_FRACTION = 0.65
+NEAR_BOTTOM_FRACTION = 0.55
+NEAR_HEIGHT_FRACTION = 0.12
+
+SPOKEN_NAMES = {
+    "vehicle": "Vehicle",
+    "person": "Person",
+    "bike": "Bike",
+    "dog": "Dog",
+    "bag": "Bag",
+}
+
+
+@dataclass(frozen=True)
+class Box:
+    class_name: str
+    rank: int
+    confidence: float
+    x0: float
+    y0: float
+    x1: float
+    y1: float
+
+
+@dataclass(frozen=True)
+class Cue:
+    kind: str
+    speech: str
+    reason: str
+    side: str | None
+    class_name: str | None
+
+
+@dataclass(frozen=True)
+class PolicyState:
+    class_name: str | None = None
+    side: str | None = None
+    seen_count: int = 0
+    hold_until: float = 0.0
+
+
+def decide(
+    boxes: list[Box],
+    width: int,
+    height: int,
+    now: float,
+    state: PolicyState,
+) -> tuple[Cue, PolicyState]:
+    subject = _select_subject(boxes, width, height)
+    if subject is None:
+        return (
+            Cue(kind="quiet", speech="", reason="clear", side=None, class_name=None),
+            PolicyState(),
+        )
+
+    side = _box_side(subject, width)
+    occupied = _occupied_sides(boxes, width, height)
+    speech, reason = _line_for(subject, side, occupied)
+    same = state.class_name == subject.class_name and state.side == side
+
+    if same and now < state.hold_until:
+        return (
+            Cue(
+                kind="quiet",
+                speech="",
+                reason="holding",
+                side=side,
+                class_name=subject.class_name,
+            ),
+            state,
+        )
+
+    if same and state.seen_count >= 3:
+        return (
+            Cue(
+                kind="obstacle",
+                speech=speech,
+                reason=reason,
+                side=side,
+                class_name=subject.class_name,
+            ),
+            PolicyState(
+                class_name=subject.class_name,
+                side=side,
+                seen_count=state.seen_count,
+                hold_until=now + HOLD_SECONDS,
+            ),
+        )
+
+    seen_count = state.seen_count + 1 if same else 1
+    pending_state = PolicyState(
+        class_name=subject.class_name,
+        side=side,
+        seen_count=seen_count,
+        hold_until=0.0,
+    )
+    if seen_count < 3:
+        return (
+            Cue(
+                kind="quiet",
+                speech="",
+                reason="pending",
+                side=side,
+                class_name=subject.class_name,
+            ),
+            pending_state,
+        )
+
+    return (
+        Cue(
+            kind="obstacle",
+            speech=speech,
+            reason=reason,
+            side=side,
+            class_name=subject.class_name,
+        ),
+        PolicyState(
+            class_name=subject.class_name,
+            side=side,
+            seen_count=seen_count,
+            hold_until=now + HOLD_SECONDS,
+        ),
+    )
+
+
+def _is_near(box: Box, height: int) -> bool:
+    return box.y1 > NEAR_BOTTOM_FRACTION * height and (
+        box.y1 - box.y0
+    ) >= NEAR_HEIGHT_FRACTION * height
+
+
+def _box_side(box: Box, width: int) -> str:
+    center_x = (box.x0 + box.x1) / 2.0
+    if center_x < LEFT_FRACTION * width:
+        return "left"
+    if center_x > RIGHT_FRACTION * width:
+        return "right"
+    return "center"
+
+
+def _best(boxes: list[Box]) -> Box:
+    return max(boxes, key=lambda box: (box.rank, box.confidence))
+
+
+def _select_subject(boxes: list[Box], width: int, height: int) -> Box | None:
+    near = [box for box in boxes if _is_near(box, height)]
+    if not near:
+        return None
+
+    ranked = [box for box in near if box.rank >= 2]
+    if ranked:
+        candidates = ranked
+    elif len(near) == 1:
+        candidates = near
+    else:
+        return None
+
+    center = [box for box in candidates if _box_side(box, width) == "center"]
+    pool = center if center else candidates
+    return _best(pool)
+
+
+def _occupied_sides(boxes: list[Box], width: int, height: int) -> dict[str, bool]:
+    occupied = {"left": False, "center": False, "right": False}
+    for box in boxes:
+        if box.rank < 2 or not _is_near(box, height):
+            continue
+        occupied[_box_side(box, width)] = True
+    return occupied
+
+
+def _line_for(subject: Box, side: str, occupied: dict[str, bool]) -> tuple[str, str]:
+    name = SPOKEN_NAMES[subject.class_name]
+    if side == "left":
+        if occupied["right"]:
+            return "Path blocked.", "blocked"
+        return f"{name} on the left. Pass on the right.", "pass"
+    if side == "right":
+        if occupied["left"]:
+            return "Path blocked.", "blocked"
+        return f"{name} on the right. Pass on the left.", "pass"
+    if occupied["left"] and occupied["right"]:
+        return "Path blocked.", "blocked"
+    if occupied["left"]:
+        return f"{name} ahead. Pass on the right.", "pass"
+    if occupied["right"]:
+        return f"{name} ahead. Pass on the left.", "pass"
+    return f"{name} ahead. Pass on the right.", "pass"
diff --git a/computer-vision/detector/policy_test.py b/computer-vision/detector/policy_test.py
new file mode 100644
index 0000000..557a9e1
--- /dev/null
+++ b/computer-vision/detector/policy_test.py
@@ -0,0 +1,185 @@
+from policy import Box, PolicyState, decide
+
+WIDTH = 640
+HEIGHT = 480
+
+
+def _box(
+    class_name: str,
+    rank: int,
+    x0: float,
+    y0: float,
+    x1: float,
+    y1: float,
+    confidence: float = 0.9,
+) -> Box:
+    return Box(
+        class_name=class_name,
+        rank=rank,
+        confidence=confidence,
+        x0=x0,
+        y0=y0,
+        x1=x1,
+        y1=y1,
+    )
+
+
+def person(x0: float, y0: float, x1: float, y1: float, confidence: float = 0.9) -> Box:
+    return _box("person", 2, x0, y0, x1, y1, confidence)
+
+
+def vehicle(x0: float, y0: float, x1: float, y1: float, confidence: float = 0.9) -> Box:
+    return _box("vehicle", 3, x0, y0, x1, y1, confidence)
+
+
+def bag(x0: float, y0: float, x1: float, y1: float, confidence: float = 0.9) -> Box:
+    return _box("bag", 1, x0, y0, x1, y1, confidence)
+
+
+# Near boxes: y1 > 264 and height >= 57.6. Centers: left < 224, right > 416.
+LEFT_PERSON = person(40, 280, 180, 450)
+RIGHT_PERSON = person(460, 280, 600, 450)
+CENTER_PERSON = person(250, 280, 390, 450)
+TOP_PERSON = person(250, 20, 390, 200)
+RIGHT_VEHICLE = vehicle(430, 200, 630, 470)
+CENTER_VEHICLE = vehicle(250, 260, 390, 450)
+CENTER_BAG = bag(280, 300, 360, 420)
+LEFT_BAG = bag(40, 300, 160, 420)
+
+
+def call(boxes: list[Box], now: float, state: PolicyState | None = None):
+    if state is None:
+        state = PolicyState()
+    return decide(boxes, WIDTH, HEIGHT, now, state)
+
+
+def after_confirm(boxes: list[Box], now: float = 0.0):
+    state = PolicyState()
+    cue = None
+    for _ in range(3):
+        cue, state = call(boxes, now, state)
+    return cue, state
+
+
+def test_no_boxes_is_clear():
+    cue, _ = call([], 0.0)
+    assert cue.speech == ""
+    assert cue.reason == "clear"
+    assert cue.kind == "quiet"
+    assert cue.side is None
+    assert cue.class_name is None
+
+
+def test_person_only_in_top_half_is_clear():
+    cue, _ = call([TOP_PERSON], 0.0)
+    assert cue.speech == ""
+    assert cue.reason == "clear"
+    assert cue.kind == "quiet"
+
+
+def test_person_on_left_right_empty():
+    cue, _ = after_confirm([LEFT_PERSON])
+    assert cue.speech == "Person on the left. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+    assert cue.side == "left"
+    assert cue.class_name == "person"
+
+
+def test_person_on_right_left_empty():
+    cue, _ = after_confirm([RIGHT_PERSON])
+    assert cue.speech == "Person on the right. Pass on the left."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+    assert cue.side == "right"
+    assert cue.class_name == "person"
+
+
+def test_center_person_vehicle_on_right():
+    cue, _ = after_confirm([CENTER_PERSON, RIGHT_VEHICLE])
+    assert cue.speech == "Person ahead. Pass on the left."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+    assert cue.side == "center"
+    assert cue.class_name == "person"
+
+
+def test_center_vehicle_beats_person_on_left():
+    cue, _ = after_confirm([CENTER_VEHICLE, LEFT_PERSON])
+    assert cue.speech == "Vehicle ahead. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+    assert cue.side == "center"
+    assert cue.class_name == "vehicle"
+
+
+def test_all_three_thirds_blocked():
+    cue, _ = after_confirm([LEFT_PERSON, CENTER_PERSON, RIGHT_PERSON])
+    assert cue.speech == "Path blocked."
+    assert cue.reason == "blocked"
+    assert cue.kind == "obstacle"
+    assert cue.side == "center"
+
+
+def test_bag_alone_in_center():
+    cue, _ = after_confirm([CENTER_BAG])
+    assert cue.speech == "Bag ahead. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+    assert cue.side == "center"
+    assert cue.class_name == "bag"
+
+
+def test_bag_beside_person_person_wins():
+    cue, _ = after_confirm([CENTER_BAG, LEFT_PERSON])
+    assert cue.speech == "Person on the left. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.class_name == "person"
+
+
+def test_calls_one_and_two_are_pending():
+    boxes = [LEFT_PERSON]
+    cue1, state = call(boxes, 0.0)
+    assert cue1.speech == ""
+    assert cue1.reason == "pending"
+    assert cue1.kind == "quiet"
+
+    cue2, _ = call(boxes, 0.0, state)
+    assert cue2.speech == ""
+    assert cue2.reason == "pending"
+    assert cue2.kind == "quiet"
+
+
+def test_call_three_speaks():
+    cue, _ = after_confirm([LEFT_PERSON])
+    assert cue.speech == "Person on the left. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
+
+
+def test_different_class_on_call_three_resets_and_stays_quiet():
+    state = PolicyState()
+    _, state = call([LEFT_PERSON], 0.0, state)
+    _, state = call([LEFT_PERSON], 0.0, state)
+    cue, _ = call([vehicle(40, 280, 180, 450)], 0.0, state)
+    assert cue.speech == ""
+    assert cue.reason == "pending"
+    assert cue.kind == "quiet"
+
+
+def test_one_second_after_spoken_cue_is_holding():
+    boxes = [LEFT_PERSON]
+    _, state = after_confirm(boxes, now=0.0)
+    cue, _ = call(boxes, 1.0, state)
+    assert cue.speech == ""
+    assert cue.reason == "holding"
+    assert cue.kind == "quiet"
+
+
+def test_five_seconds_after_spoken_cue_speaks_again():
+    boxes = [LEFT_PERSON]
+    _, state = after_confirm(boxes, now=0.0)
+    cue, _ = call(boxes, 5.0, state)
+    assert cue.speech == "Person on the left. Pass on the right."
+    assert cue.reason == "pass"
+    assert cue.kind == "obstacle"
